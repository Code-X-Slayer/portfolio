# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — VIJAY KARTHIK PORTFOLIO
# ==============================================================================

# 1. Gmail SMTP Credentials (Contact Form)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email_address
GMAIL_PASS=your_16_character_app_password

# 2. Groq LLM API Configuration (AI Mode)
# Get your free API key at: https://console.groq.com/keys
# Option A: Single API key
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: Multiple API keys with automatic round-robin rotation & rate-limit fallback
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Optional: Preferred model (defaults to llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
